# Secrets and local environment — never commit these
.env
.streamlit/secrets.toml

# Virtual environments
.venv/
.venv.broken/
venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# IDE local settings
.vscode/
.idea/

# macOS
.DS_Store

# Generated temporary files
*.tmp
*.log
tmp/

# Editable-install metadata
*.egg-info/

# Local database (dev)
*.db
# Knowledge base: keep the structure + docs, ignore generated stores and the
# (potentially large / licensed) source documents.
data/chroma/*
data/processed/*
data/raw/*
data/knowledge/*
!data/raw/.gitkeep
!data/raw/README.md
!data/processed/.gitkeep
!data/chroma/.gitkeep
!data/knowledge/.gitkeep

# Local editor/launch config
.claude/
