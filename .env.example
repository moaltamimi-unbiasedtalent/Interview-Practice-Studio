# Local development fallback only. Streamlit secrets take priority.
# Copy this file to .env and add your key. Never commit .env.
OPENROUTER_API_KEY=

# --- Speech-to-text (optional; enables recorded voice answers) ---------------
# Google Cloud Speech-to-Text V2 (Chirp 3). Set the project id to enable voice.
# GOOGLE_SPEECH_PROJECT_ID=your-gcp-project-id
# GOOGLE_SPEECH_LOCATION=global
#
# Credentials use Application Default Credentials. Point to a service-account
# JSON key file that you must NEVER commit:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Live interview (optional, experimental; Gemini Live) --------------------
# The permanent Gemini key is used ONLY on the backend to mint short-lived
# ephemeral tokens; it is never sent to the browser. Never commit a real key.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- Accounts & persistence (optional) ---------------------------------------
# Local development allows anonymous use; set true to require login (production).
# APP_AUTH_REQUIRED=false
# SQLite for dev; a PostgreSQL URL for production (never commit real credentials).
# DATABASE_URL=sqlite:///data/interview_studio.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- Career Intelligence Copilot (RAG assistant) -----------------------------
# Reuses OPENROUTER_API_KEY above. Optional overrides:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# COPILOT_MODEL=openai/gpt-5-mini
# COPILOT_EMBEDDING_MODEL=text-embedding-3-small
# COPILOT_EMBEDDING_BASE_URL=https://api.openai.com/v1
# COPILOT_EMBEDDING_API_KEY=your-embeddings-key   # if embeddings use a different provider
# COPILOT_CHROMA_DIR=data/chroma
# COPILOT_DEBUG=false
