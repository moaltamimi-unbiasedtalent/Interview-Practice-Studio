# Copy this file to .streamlit/secrets.toml and add your real key.
# .streamlit/secrets.toml is gitignored and must never be committed.
OPENROUTER_API_KEY = "your-openrouter-api-key"

# --- Speech-to-text (optional; enables recorded voice answers) ---------------
# Google Cloud Speech-to-Text V2 (Chirp 3). Set the project id to enable voice.
# GOOGLE_SPEECH_PROJECT_ID = "your-gcp-project-id"
# GOOGLE_SPEECH_LOCATION = "global"
#
# Credentials use Application Default Credentials — set the environment variable
# GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON key file that you must
# NEVER commit. Do not paste the key contents here.

# --- Live interview (optional, experimental; Gemini Live) --------------------
# The permanent Gemini key is used ONLY on the backend to mint short-lived
# ephemeral tokens; it is never sent to the browser. Never commit a real key.
# GEMINI_API_KEY = "your-gemini-api-key"
# GEMINI_LIVE_MODEL = "gemini-2.0-flash-live-001"
